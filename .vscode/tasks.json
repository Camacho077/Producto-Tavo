{
  // Terminal > Ejecutar tarea > "Arrancar backend y frontend" (o Ctrl+Mayús+B).
  // Usa los mismos scripts que el README: cierran instancias viejas,
  // comprueban el puerto y arrancan backend en 8002 y frontend en 5175.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend (8002)",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/automatizaciones/dev/start-backend.ps1"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "servidores" }
    },
    {
      "label": "Frontend (5175)",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/automatizaciones/dev/start-frontend.ps1"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "servidores" }
    },
    {
      "label": "Arrancar backend y frontend",
      "dependsOn": ["Backend (8002)", "Frontend (5175)"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
