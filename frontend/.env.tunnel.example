# Modo `tunnel` de Vite: se usa al compilar la demo que se comparte por internet
#   npx vite build --mode tunnel
# VITE_API_URL queda INCRUSTADO en el paquete compilado, así que aquí NO puede
# apuntar a localhost: debe ser la URL pública del túnel del backend.
# automatizaciones/demo/start-demo-tunel.ps1 genera .env.tunnel solo con la
# URL real del túnel; este archivo es solo la plantilla.
VITE_API_URL=https://TU-TUNEL-DEL-BACKEND.loca.lt/api/v1
