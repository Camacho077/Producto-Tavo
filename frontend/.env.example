# =============================================================================
# Plantilla de configuración del FRONTEND.
#
#   Copia este archivo a frontend/.env:
#     Windows (PowerShell):  Copy-Item frontend\.env.example frontend\.env
#     Linux / macOS:         cp frontend/.env.example frontend/.env
#   (automatizaciones/setup.ps1 y setup.sh lo hacen solos).
#
# frontend/.env NO se versiona. Si falta VITE_API_URL, `npm run dev` y
# `npm run build` se detienen con un mensaje que dice qué copiar.
# Las variables VITE_* quedan INCRUSTADAS en el JavaScript compilado: nunca
# pongas secretos aquí.
# =============================================================================

# OBLIGATORIA. URL base de la API del backend, incluido el prefijo /api/v1.
# Puerto 8001 y no 8000: en Windows el 8000 suele quedar reservado por
# Hyper-V/WSL (WinError 10013). Ver "Empezar desde cero" en el README.
# Debe coincidir con el puerto en el que corre uvicorn
# (automatizaciones/dev/start-backend.ps1 usa el 8001).
VITE_API_URL=http://localhost:8001/api/v1
