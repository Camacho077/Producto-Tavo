# =============================================================================
# Plantilla de configuración del BACKEND.
#
#   Copia este archivo a backend/.env y ajusta lo que necesites:
#     Windows (PowerShell):  Copy-Item backend\.env.example backend\.env
#     Linux / macOS:         cp backend/.env.example backend/.env
#   (automatizaciones/setup.ps1 y setup.sh lo hacen solos y además generan
#   una SECRET_KEY aleatoria).
#
# backend/.env NO se versiona (tiene secretos). Si falta el archivo o una
# variable OBLIGATORIA, el backend no arranca y dice exactamente qué falta.
# Para ver qué tiene cargado tu entorno:  cd backend  ->  python -m app.diagnostico
# =============================================================================

# ---------------------------------------------------------------- OBLIGATORIAS

# Cadena de conexión a Postgres: postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE
# Con el contenedor de infra/docker-compose.yml (servicio "db") es exactamente
# este valor. La base debe existir; el setup la crea si el usuario puede.
# Ojo: el Postgres de ESTE producto escucha en el 5433 del equipo (el 5432 es
# del Producto JS). Base y usuario propios: tavo_erp / tavo_admin.
DATABASE_URL=postgresql://tavo_admin:tavo_admin@localhost:5433/tavo_erp

# Clave con la que se firman los tokens de sesión (JWT). Quien la conozca
# puede fabricar sesiones válidas: en producción debe ser larga (32+
# caracteres) y aleatoria, y el backend RECHAZA este valor de ejemplo fuera de
# desarrollo. Generar una:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esto-en-produccion

# ------------------------------------------------------------------ OPCIONALES
# (si no se definen, se usa el valor que aparece aquí)

# Nombre que muestra la documentación de la API (/docs).
APP_NAME=JS Restaurante

# development | production (cualquier otro valor se rechaza al arrancar).
#   development: CORS acepta ADEMÁS cualquier origen local en cualquier
#     puerto (localhost, 127.0.0.1, [::1] y la red privada 10.x/172.16-31.x/
#     192.168.x), así da igual en qué puerto o URL abras el frontend.
#   production: CORS acepta SOLO la lista CORS_ORIGINS.
ENV=development

# Puerto del backend. Es 8002: el 8001 es del Producto JS (corren a la vez en
# la misma máquina) y el 8000 suele estar reservado por Windows/Hyper-V/WSL
# (WinError 10013). El frontend llama al 8002 (VITE_API_URL en frontend/.env).
# Lo leen `python -m app.main`, start-backend.ps1 y verificar-puertos.ps1.
# `uvicorn app.main:app` a secas no lo lee: el backend se niega a arrancar en
# otro puerto y dice cómo hacerlo (app/core/arranque.py).
PORT=8002

# Prefijo de todas las rutas de la API. El frontend lo incluye en VITE_API_URL.
API_V1_PREFIX=/api/v1

# Plan con el que nace una empresa creada desde la pantalla de registro:
# basico | estandar | pro_ia. Con "basico" el menú oculta Compras y Ventas.
PLAN_POR_DEFECTO=pro_ia

# Algoritmo de firma del JWT. No cambiarlo salvo que sepas por qué.
ALGORITHM=HS256

# Duración de la sesión normal, en minutos (480 = 8 horas).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Duración de la sesión cuando se marca "Recordarme" en el login, en días.
ACCESS_TOKEN_RECORDARME_DIAS=30

# Base de datos que usa pytest. SEPARADA de la de desarrollo: la suite la
# borra y la vuelve a crear. Se crea sola si el usuario tiene permiso.
TEST_DATABASE_URL=postgresql://tavo_admin:tavo_admin@localhost:5433/tavo_erp_test

# Orígenes (URL del frontend) permitidos por CORS. En development además se
# acepta cualquier origen local (ver ENV), así que esta lista importa sobre
# todo en producción, donde es la ÚNICA que manda (p. ej.
# CORS_ORIGINS=["https://app.tuempresa.co"]).
# Formato: lista JSON con comillas dobles, o separada por comas:
#   CORS_ORIGINS=["http://localhost:5175","http://127.0.0.1:5175"]
#   CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
# Ojo: "localhost" y "127.0.0.1" son orígenes DISTINTOS para el navegador.
CORS_ORIGINS=["http://localhost:5175","http://127.0.0.1:5175"]
