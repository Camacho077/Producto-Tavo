# Secretos: cualquier .env en cualquier carpeta (los .env.example SÍ se versionan)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Python
backend/venv/
venv/
.venv/
backend/__pycache__/
backend/**/__pycache__/
*.pyc
backend/.env

# Node / frontend
node_modules/
frontend/dist/
dist/
frontend/.env
frontend/.env.tunnel

# Bases de datos y respaldos locales (los datos de cada máquina no viajan por git)
*.db
*.sqlite
*.sqlite3
*.dump
*.bak

# General
.DS_Store
*.log

# Tests / herramientas
backend/.pytest_cache/
.claude/settings.local.json
automatizaciones/demo/logs/

# Impeccable (archivos efímeros y por desarrollador; config.json, PRODUCT.md
# y DESIGN.md SÍ se versionan)
.impeccable/config.local.json
.impeccable/live/
.impeccable/bin/
.impeccable/*.tmp
.impeccable/design.json.*
# Binarios del motor que descarga el instalador (uno por plataforma)
.claude/skills/impeccable/scripts/bin/

# Worktrees locales de sesiones de Claude Code (repos anidados, nunca se versionan)
.claude/worktrees/
